function log
{
    /usr/bin/logger -s -t networking-finish "$@"
}

function networking_finish
{
    log "networking finish"

    [ -e  /etc/config-tools/config_switch ] && /etc/config-tools/config_switch --init
}

case "$1" in
start)
    networking_finish
    /etc/config-tools/config_eth_leds 
    ;;
stop)
    ;;
reload)
    networking_finish
    ;;
restart|force-reload)
    networking_finish
    ;;
*)
    N=$BASH_COMMAND
    echo "usage: $N {start|restart|force-reload}" >&2
    exit 1
    ;;
esac

exit 0
